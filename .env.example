OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
PUBLIC_EXPERIMENT_KEY=demo2025
NEXT_PUBLIC_PUBLIC_EXPERIMENT_KEY=demo2025
NEXT_PUBLIC_VERCEL_APP_URL=https://openai-chatkit-starter-app-xi.vercel.app

WORDPRESS_BASE_URL=https://tu-sitio.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# Clave del equipo editorial para publicar en WordPress (solo servidor, mínimo 16 caracteres).
# Sin ella nadie puede publicar. Nunca uses el prefijo NEXT_PUBLIC_ para esta variable.
ADMIN_PUBLISH_SECRET=

# Publicación de visitantes con revisión automática (moderación + revisión editorial con IA).
# Desactivada salvo que valga "on". Requiere ADMIN_PUBLISH_SECRET (firma las portadas).
COMMUNITY_PUBLISHING=off
COMMUNITY_DAILY_LIMIT=10
# Opcional: modelo para la revisión (por defecto, OPENAI_TEXT_MODEL).
OPENAI_REVIEW_MODEL=

# Opcional: activa la búsqueda y el fallback fotográfico.
UNSPLASH_ACCESS_KEY=

# Opcional: integración de ChatKit.
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=
OPENAI_API_BASE=https://api.openai.com
CHATKIT_API_BASE=https://api.openai.com
NEXT_PUBLIC_CHATKIT_SCRIPT_URL=/api/chatkit-script
